[gd_scene format=3]

[node name="TrackSectionInfo" type="HBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="LeadButton" type="Button" parent="."]
layout_mode = 2
theme_type_variation = &"AppLeadButton"
toggle_mode = true
text = "Lead"
tooltip_text = "Choose the track that determines this section's length."

[node name="SectionInfoHolder" type="RichTextLabel" parent="."]
custom_minimum_size = Vector2(0, 20)
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
text = "[i]Section[/i] A"
fit_content = true
scroll_active = false
autowrap_mode = 0
horizontal_alignment = 1
vertical_alignment = 1
